pipeline {
    agent any

    tools {
        // Configure this NodeJS installation in Jenkins' NodeJS plugin.
        nodejs 'nodejs'
    }

    environment {
        // HUB_APP_URL must point to an app already running and reachable by this agent.
        CYPRESS_BASE_URL = "${env.HUB_APP_URL ?: 'http://localhost:3000'}"
    }

    stages {
        stage('Install dependencies') {
            steps {
                shOrBat('npm ci')
            }
        }

        stage('Wait for external application') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npx wait-on --timeout 120000 "$CYPRESS_BASE_URL"'
                    } else {
                        bat 'npx wait-on --timeout 120000 %CYPRESS_BASE_URL%'
                    }
                }
            }
        }

        stage('Run Cypress E2E tests') {
            steps {
                shOrBat('npm test')
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'cypress/videos/**/*.mp4,cypress/screenshots/**/*', allowEmptyArchive: true
        }
    }
}

def shOrBat(command) {
    if (isUnix()) {
        sh command
    } else {
        bat command
    }
}
