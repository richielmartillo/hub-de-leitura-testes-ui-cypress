pipeline {
    agent any

    tools {
        nodejs 'nodejs'
    }

    stages {
        stage('Esperar app') {
            steps {
                bat 'npx wait-on http://localhost:3000'
            }
        }

      post {
    always {
        bat 'taskkill /F /IM node.exe >nul 2>&1 || exit 0'
    }
}
    }
}